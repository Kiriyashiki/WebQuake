{
    "name": "kyoquake",
    "version": "1.3.0",
    "description": "Earthquake reports viewer for Japan (JMA)",
    "author": "Kiriyashiki",
    "desktopName": "kyoquake.desktop",
    "private": true,
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:desktop": "vite build --mode desktop",
        "preview": "vite preview",
        "tauri": "tauri",
        "electron": "electron . --no-sandbox",
        "electron:dev": "electron . --no-sandbox --dev",
        "electron:build:linux": "pnpm build:desktop && electron-builder --linux AppImage deb rpm --publish never"
    },
    "dependencies": {
        "@tauri-apps/plugin-http": "^2.9.0",
        "@tauri-apps/plugin-log": "^2.10.2",
        "@tauri-apps/plugin-opener": "^2.7.3",
        "maplibre-gl": "^6.17.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4",
        "@turf/turf": "^7.4.0",
        "electron": "^45.2.3",
        "electron-builder": "^26.18.0",
        "vite": "^8.3.7"
    }
}
