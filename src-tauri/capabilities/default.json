{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://axis.prioris.jp/api/*"
        },
        {
          "url": "https://www.data.jma.go.jp/developer/xml/*"
        },
        {
          "url": "https://api.github.com/repos/Kiriyashiki/WebQuake/releases/*"
        }
      ]
    },
    "opener:default",
    "log:default"
  ]
}
